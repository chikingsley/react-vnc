{
  "name": "@simonpeacocks/react-vnc",
  "version": "3.4.1",
  "description": "A React Component to connect to a websockified VNC client using noVNC.",
  "author": "chikingsley",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/react-vnc.js",
  "source": "src/lib/index.tsx",
  "typings": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/react-vnc.js",
      "require": "./dist/react-vnc.umd.cjs"
    }
  },
  "files": [
    "dist/"
  ],
  "keywords": [
    "vnc",
    "noVNC",
    "react-vnc",
    "websocket",
    "websockify"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chikingsley/react-vnc.git"
  },
  "bugs": {
    "url": "https://github.com/chikingsley/react-vnc/issues"
  },
  "engines": {
    "node": ">=10"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "vite build --mode=app",
    "build:lib": "tsc -b tsconfig.lib.json && vite build --mode=lib",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "e2e:install": "playwright install chromium",
    "e2e:test": "playwright test",
    "e2e:test:headed": "playwright test --headed",
    "e2e:test:ui": "playwright test --ui",
    "e2e:test:watch": "PW_HEADLESS=false PW_SLOWMO_MS=350 playwright test --headed --workers=1",
    "e2e:test:report": "playwright test --reporter=list,html",
    "e2e:up": "docker compose -f docker-compose.e2e.yml up -d --build",
    "e2e:down": "docker compose -f docker-compose.e2e.yml down -v --remove-orphans",
    "test:real": "bun run e2e:install && bun run e2e:test",
    "test:real:headed": "bun run e2e:install && bun run e2e:test:headed",
    "test:real:ui": "bun run e2e:install && bun run e2e:test:ui",
    "test:real:watch": "bun run e2e:install && bun run e2e:test:watch",
    "test:real:report": "bun run e2e:install && bun run e2e:test:report && bunx playwright show-report",
    "test:real:debug": "PWDEBUG=1 bun run test:real:headed",
    "knip": "knip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "tsc -b tsconfig.lib.json && vite build --mode=lib"
  },
  "dependencies": {
    "@novnc/novnc": "1.7.0-beta",
    "@types/novnc__novnc": "^1.6.0",
    "react-compiler-runtime": "^1.0.0"
  },
  "peerDependencies": {
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@happy-dom/global-registrator": "^20.7.0",
    "@playwright/test": "^1.58.2",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.4",
    "@semantic-release/release-notes-generator": "^14.1.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^25.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.4",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.0.2",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.1",
    "eslint-plugin-react-dom": "^2.13.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "eslint-plugin-react-x": "^2.13.0",
    "globals": "^17.3.0",
    "knip": "^5.85.0",
    "semantic-release": "^25.0.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
